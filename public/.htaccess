# =============================================================================
# VioraRental - Apache / LiteSpeed configuration
# -----------------------------------------------------------------------------
# For the static build (DEPLOY_TARGET=static). Upload the contents of ./out to
# public_html; this file travels with them because anything in ./public is
# copied into the export.
#
# On a Node host these rules are not used - next.config.ts carries the
# equivalent header configuration instead.
#
# Hostinger note: confirm HTTPS is active and the SSL certificate is issued in
# hPanel BEFORE enabling the HTTPS redirect and HSTS below, or the site will be
# unreachable. HSTS in particular is difficult to undo once browsers cache it.
# =============================================================================

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Content Security Policy.
    # The 'unsafe-inline' script source is required by Next.js hydration data.
    # Adjust connect-src / script-src when adding analytics or a form endpoint:
    #   Google Analytics -> https://www.googletagmanager.com https://*.google-analytics.com
    #   Formspree        -> https://formspree.io
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; upgrade-insecure-requests"

    # Enable only after the certificate is confirmed working.
    # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# --- HTTPS and canonical host -----------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS. Enable once the certificate is active.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Canonical host: serve one hostname only, so the same page is never
    # reachable at both www and apex (duplicate content).
    # Pick ONE of the two blocks below and uncomment it.

    # Apex -> www
    # RewriteCond %{HTTP_HOST} ^viorarental\.com$ [NC]
    # RewriteRule ^ https://www.viorarental.com%{REQUEST_URI} [L,R=301]

    # www -> apex
    # RewriteCond %{HTTP_HOST} ^www\.viorarental\.com$ [NC]
    # RewriteRule ^ https://viorarental.com%{REQUEST_URI} [L,R=301]

    # --- Permanent redirects ------------------------------------------------
    # /list-your-property is an alias people type and link to. It is a 301
    # rather than a second page, so the two URLs never compete in the index.
    RewriteRule ^list-your-property/?$ /become-a-host/ [L,R=301]

    # Add future redirects here as property slugs change, so no inbound link
    # ever lands on the 404 page:
    # RewriteRule ^properties/old-slug/?$ /properties/new-slug/ [L,R=301]

    # The export uses trailingSlash, so /about/ maps to /about/index.html.
    # Redirect the slashless form once, rather than serving both.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# --- Custom error pages ------------------------------------------------------
ErrorDocument 404 /404.html

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# --- Caching -----------------------------------------------------------------
# Next.js fingerprints files under /_next/static, so they are safe to cache
# permanently. HTML must not be cached long, or deploys will not be seen.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/avif                    "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|woff2|svg|png|jpg|jpeg|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# --- MIME types --------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# --- Hardening ---------------------------------------------------------------
# Never serve dotfiles or environment files, whatever ends up in the directory.
<FilesMatch "^\.|(\.env|\.log|\.bak|\.sql|\.yml|\.map)$">
    Require all denied
</FilesMatch>

Options -Indexes
ServerSignature Off
