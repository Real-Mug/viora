# ---------------------------------------------------------------------------
# VioraRental environment configuration
# Copy to `.env.local` for development. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser - keep secrets unprefixed.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://viorarental.com

# static = `next build` emits ./out for Hostinger public_html (no route handlers)
# node   = server build, enables /api routes, server-side validation, rate limits
DEPLOY_TARGET=static

# placeholder = sample content is rendered and visibly labelled as a sample
# live        = only real, verified content is rendered; samples are excluded
NEXT_PUBLIC_CONTENT_MODE=placeholder

# Where public forms POST. On a static host this is a third-party form endpoint
# (Formspree, Web3Forms, Hostinger form handler). On a Node host, set to /api/leads.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional bot protection. Leave blank to disable; the honeypot + timing checks
# in src/lib/forms stay active either way.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics. Leave blank to ship the site with no third-party scripts at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search Console HTML meta verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
