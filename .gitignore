.DS_Store

# Local env
.env*.local

# Generated responsive image variants (scripts/generate-image-variants.mjs).
# Regenerated by prebuild/predev; the manifest beside them is committed.
public/images/**/*-[0-9]*w.webp
public/images/**/*-[0-9]*w.avif

# Raw video sources. The encoded files in public/video are what the site ships;
# a 4K master is tens of megabytes and has no business in the history.
/*.mp4
/*.mov
/*.m4v
